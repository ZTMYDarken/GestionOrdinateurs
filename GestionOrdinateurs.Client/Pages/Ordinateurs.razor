@page "/ordinateurs"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Blazored.SessionStorage
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage

<PageTitle>Ordinateurs</PageTitle>

<h1>Ordinateurs</h1>

@if (errorMessage is not null)
{
    <p class="text-danger">@errorMessage</p>
}
else if (ordinateurs is null)
{
    <p>Chargement...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prix</th>
                <th>Devise</th>
                <th>Vendu</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ordinateur in ordinateurs)
            {
                <tr>
                    <td>@ordinateur.Nom</td>
                    <td>@ordinateur.Prix.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))</td>
                    <td>€</td>
                    <td>@(ordinateur.Vendu ? "Oui" : "Non")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<OrdinateurRow>? ordinateurs;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var token = await SessionStorage.GetItemAsync<string>("jwtToken");
        if (string.IsNullOrWhiteSpace(token))
        {
            errorMessage = "Connectez-vous pour consulter les ordinateurs.";
            return;
        }

        using var request = new HttpRequestMessage(HttpMethod.Get, "api/Ordinateurs");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var client = HttpClientFactory.CreateClient("Gateway");
        using var response = await client.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = $"Impossible de charger les ordinateurs (HTTP {(int)response.StatusCode}).";
            return;
        }

        ordinateurs = await response.Content.ReadFromJsonAsync<List<OrdinateurRow>>() ?? [];
    }

    private sealed record OrdinateurRow(string Nom, decimal Prix, bool Vendu);
}
