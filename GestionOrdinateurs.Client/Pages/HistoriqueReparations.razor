@page "/historique-reparations"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Blazored.SessionStorage
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage

<PageTitle>Historique des réparations</PageTitle>

<h1>Historique des réparations</h1>

@if (errorMessage is not null)
{
    <p class="text-danger">@errorMessage</p>
}
else if (reparations is null)
{
    <p>Chargement...</p>
}
else if (reparations.Count == 0)
{
    <p>Aucune réparation dans l’historique.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ordinateur</th>
                <th>Technicien</th>
                <th>Type de réparation</th>
                <th>Date d’intervention</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reparation in reparations)
            {
                <tr>
                    <td>@reparation.NomOrdinateur</td>
                    <td>@reparation.Technicien</td>
                    <td>@reparation.TypeReparation</td>
                    <td>@reparation.DateIntervention.ToLocalTime().ToString("g", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<HistoriqueReparationRow>? reparations;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var token = await SessionStorage.GetItemAsync<string>("jwtToken");
        if (string.IsNullOrWhiteSpace(token))
        {
            errorMessage = "Connectez-vous pour consulter l’historique.";
            return;
        }

        using var request = new HttpRequestMessage(HttpMethod.Get, "api/reparations/historique");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var client = HttpClientFactory.CreateClient("Gateway");
        using var response = await client.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = $"Impossible de charger l’historique (HTTP {(int)response.StatusCode}).";
            return;
        }

        reparations = await response.Content.ReadFromJsonAsync<List<HistoriqueReparationRow>>() ?? [];
    }

    private sealed record HistoriqueReparationRow(
        int OrdinateurId,
        string NomOrdinateur,
        string Technicien,
        string TypeReparation,
        DateTime DateIntervention);
}
